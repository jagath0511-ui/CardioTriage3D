{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60,
        "includeFiles": [
          "backend/models_bundle.pkl",
          "backend/evaluation_report.json",
          "frontend/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.py"
    },
    {
      "src": "/health",
      "dest": "backend/server.py"
    },
    {
      "src": "/(.*)",
      "dest": "backend/server.py"
    }
  ]
}
